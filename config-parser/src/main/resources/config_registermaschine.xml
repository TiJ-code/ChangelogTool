<?xml version="1.0" encoding="utf-8"?>
<config version="4" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="config.v4.xsd">
    <versioning>
        <rule name="maven">
            <filename regex=".*/?pom\.xml"/>
            <version regex="&lt;version&gt;([^&lt;]+)&lt;/version&gt;"/>
        </rule>
        <phases>
            <phase name="release">
                <next>release</next>
                <prefix>alarm</prefix>
                <suffix>im</suffix>
                <formatter>{#prefix}-{#numeric_version}-{#}</formatter>
                <events>
                    <event on="phase_entered">
                        <major>0</major>
                        <minor>1</minor>
                        <patch>2</patch>
                    </event>
                </events>
            </phase>
        </phases>
    </versioning>
    <categories>
        <category name="additions">added</category>
        <category name="refactorings">refactored</category>
        <category name="fixes">fixed</category>
        <category name="removals">removed</category>
    </categories>
    <components>
        <component id="archive" name="Archive"/>
        <component id="config-parser" name="Config Parser"/>
        <component id="markdown" name="Markdown"/>
        <component id="patches" name="Patches"/>
        <component id="versioning" name="Versioning"/>
        <component id="xml-model" name="XML Model"/>
    </components>
    <topics>
        <topic name="default">
            <component-ref ref="archive"/>
            <component-ref ref="config-parser"/>
            <component-ref ref="markdown"/>
            <component-ref ref="patches"/>
            <component-ref ref="versioning"/>
            <component-ref ref="xml-model"/>
        </topic>
    </topics>
    <breaking.changes>
        <entry>major</entry>
        <entry>minor</entry>
        <entry>trivial</entry>
    </breaking.changes>
</config>