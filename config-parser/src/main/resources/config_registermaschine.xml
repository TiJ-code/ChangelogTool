<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE config SYSTEM "config.v2.dtd">
<config version="2">
    <versioning>
        <rule name="maven">
            <filename regex=".*/?pom\.xml"/>
            <version regex="&lt;version&gt;([^&lt;]+)&lt;/version&gt;"/>
        </rule>
    </versioning>
    <categories>
        <category name="additions">added</category>
        <category name="refactorings">refactored</category>
        <category name="fixes">fixed</category>
        <category name="removals">removed</category>
    </categories>
    <topics>
        <entry>api</entry>
        <entry>core</entry>
        <entry>instructions</entry>
    </topics>
    <breaking.changes>
        <entry>major</entry>
        <entry>minor</entry>
        <entry>trivial</entry>
    </breaking.changes>
</config>