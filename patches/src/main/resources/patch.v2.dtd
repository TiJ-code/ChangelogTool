<?xml version="1.0" encoding="utf-8"?>

<!ELEMENT patch (component*)>
<!ATTLIST patch version (2) #REQUIRED>

<!-- Component Changes -->

<!ELEMENT component (category*)>
<!ATTLIST component
        ref CDATA #REQUIRED>

<!-- Categories -->

<!ELEMENT category (breaking*, entry*)>
<!ATTLIST category
        name CDATA #REQUIRED>

<!-- Breaking Changes -->

<!ELEMENT breaking (entry*)>
<!ATTLIST breaking
        severity CDATA #REQUIRED>

<!-- Entries -->

<!ELEMENT entry ANY>